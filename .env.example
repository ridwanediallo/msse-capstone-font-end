# Dev only: where the Vite dev server proxies /api (vite.config.js).
# Not compiled into the client bundle.
VITE_API_URL=http://127.0.0.1:5001

# Production builds: absolute origin of the backend API, compiled into the
# client bundle (src/api.js). Leave empty in dev — same-origin + proxy.
VITE_API_BASE=
